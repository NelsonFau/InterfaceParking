# Copiar a .env y completar. Toda variable VITE_ termina en el JavaScript del navegador:
# ninguna es secreta y ningún client secret debe ir acá (la SPA es un cliente público).

# Base de la API, con el sufijo /api/v1
VITE_API_BASE_URL=https://localhost:7076/api/v1

# Auth0 (tenant de desarrollo). El dominio va sin https://
VITE_AUTH0_DOMAIN=parkingcontrol-dev.us.auth0.com
VITE_AUTH0_CLIENT_ID=0vqDMIvIDuPnYEbUMvzxSjiRDrkbCyXr
VITE_AUTH0_AUDIENCE=https://api.parkingcontrol.dev
